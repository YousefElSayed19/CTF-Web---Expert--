@page "/admin/import"
@model VaultCorp.Pages.Admin.ImportModel
@{
    ViewData["Title"] = "Import Backup from URL";
}

<div class="page-header">
    <h1>Import Backup from URL</h1>
    <p class="subtitle">Paste a direct link to a backup archive or JSON export.</p>
</div>

<div class="section-card">
    <form method="post">
        <label>Backup URL</label>
        <input type="url"
               name="url"
               placeholder="https://storage.example.com/backup.json"
               value="@Model.LastUrl"
               required />
        <button type="submit" class="btn-primary">Import</button>
    </form>
</div>

@if (Model.Result is not null)
{
    <div class="section-card result-card">
        @if (Model.Result.Blocked)
        {
            <div class="alert alert-error">
                <strong>Security Gateway Block</strong><br/>
                <code>@Model.Result.ErrorCode</code> — @Model.Result.ErrorReason
            </div>
        }
        else if (!Model.Result.Success && !string.IsNullOrEmpty(Model.Result.ErrorCode))
        {
            <div class="alert alert-error">
                <strong>@Model.Result.ErrorCode</strong><br/>
                @Model.Result.ErrorReason
            </div>
        }
        else
        {
            <h3>Response <span class="badge">HTTP @Model.Result.StatusCode</span></h3>
            <pre class="response-body">@Model.Result.Content</pre>
        }
    </div>
}
